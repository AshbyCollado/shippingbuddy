{
  "name": "shipping-buddy",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "launch": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/Start-ShippingBuddy.ps1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --grep-invert @performance",
