    "test:launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-production-launcher.ps1"
  },
  "dependencies": {
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.7.0",
    "gsap": "3.15.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.1",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.0",
    "fast-check": "4.9.0",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
